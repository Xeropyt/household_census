    "def clean_au_data(file_path, header_marker, prefix_map,\n",
    "                  excluded_areas, excluded_rent, national_label):\n",
    "    \"\"\"Load the ABS TableBuilder export and return a tidy long-format table.\"\"\"\n",
    "    # Find the header row by its content rather than hard-coding a row number.\n",
    "    # The marker also appears in the table title, so match it as a quoted CSV cell.\n",
    "    with open(file_path, encoding=\"utf-8-sig\") as f:\n",
    "        header_row = next(i for i, line in enumerate(f) if f',\"{header_marker}\",' in line)\n",
    "    body = pd.read_csv(file_path, skiprows=header_row, encoding=\"utf-8-sig\", dtype=str)\n",
    "\n",
    "    body = body.rename(columns={body.columns[0]: \"raw_household\",\n",
    "                                body.columns[1]: \"area\"})\n",
    "    body = body.loc[:, ~body.columns.str.startswith(\"Unnamed\")]  # trailing empty column\n",
    "    first_band = body.columns[2]\n",
    "    body = body[body[first_band].notna()]      # keep data rows only (drops dimension-name row and footer notes)\n",
    "    body[\"raw_household\"] = body[\"raw_household\"].ffill()        # label only on first row of each block\n",
    "\n",
    "    long = body.melt(id_vars=[\"raw_household\", \"area\"],\n",
    "                     var_name=\"rent_band\", value_name=\"count\")\n",
    "    long = long[~long[\"rent_band\"].isin(excluded_rent)\n",
    "                & ~long[\"area\"].isin(excluded_areas)].copy()\n",
    "    long[\"count\"] = pd.to_numeric(long[\"count\"])\n",
    "    long[\"area\"] = long[\"area\"].replace({national_label: NATIONAL})\n",
    "    long[\"country\"] = \"Australia\"\n",
    "    return harmonise(long, prefix_map)\n",
    "\n",
    "\n",
    "au_rent = clean_au_data(AU_FILE, AU_HEADER_MARKER, HOUSEHOLD_PREFIX_MAP_AU,\n",
    "                        AU_EXCLUDED_AREAS, AU_EXCLUDED_RENT, AU_NATIONAL_LABEL)\n",
    "display(au_rent.head())"
