    "\"\"\"\n",
    "RQ3: Do household types with higher urban concentration also face higher rent burdens,\n",
    "and is the urban-regional rent gap consistent between Australia and New Zealand?\n",
    "\n",
    "This script cleans both countries' census exports, computes median rent by\n",
    "household type x region (urban/regional), and compares the resulting rent gaps.\n",
    "\"\"\"\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# AUSTRALIA\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def rent_range_to_midpoint_au(range_str):\n",
    "    \"\"\"\n",
    "    Convert an ABS rent range string like '$100-$124' into its numeric midpoint.\n",
    "    The open-ended top band is assigned an assumed midpoint (stated assumption).\n",
    "    \"\"\"\n",
    "    if range_str == \"$950 and over\":\n",
    "        return 1050.0\n",
    "    numbers = re.findall(r\"\\d+\", range_str)\n",
    "    low, high = int(numbers[0]), int(numbers[1])\n",
    "    return (low + high) / 2\n",
    "\n",
    "\n",
    "def classify_region_au(remoteness_area):\n",
    "    \"\"\"ABS remoteness categories collapsed to a simple urban/regional split.\"\"\"\n",
    "    return \"urban\" if remoteness_area == \"Major Cities of Australia\" else \"regional\"\n",
    "\n",
    "\n",
    "def load_and_clean_au(filepath):\n",
    "    df = pd.read_csv(filepath, skiprows=10)\n",
    "    df = df.rename(columns={df.columns[0]: \"household_type\", df.columns[1]: \"remoteness_area\"})\n",
    "    df = df.drop(columns=[df.columns[-1]], errors=\"ignore\")\n",
    "\n",
    "    df = df[df[\"remoteness_area\"] != \"Remoteness Areas (National) (EN)\"]\n",
    "    df[\"household_type\"] = df[\"household_type\"].ffill()\n",
    "    df = df.dropna(subset=[\"remoteness_area\"])\n",
    "\n",
    "    exclude_household = [\"Not applicable\", \"Total\", \"INFO\"]\n",
    "    exclude_remoteness = [\"Total\", \"Migratory - Offshore - Shipping\"]\n",
    "    df = df[~df[\"household_type\"].isin(exclude_household)]\n",
    "    df = df[~df[\"remoteness_area\"].isin(exclude_remoteness)]\n",
    "\n",
    "    rent_columns = [c for c in df.columns if c not in [\"household_type\", \"remoteness_area\"]]\n",
    "    long_df = df.melt(\n",
    "        id_vars=[\"household_type\", \"remoteness_area\"],\n",
    "        value_vars=rent_columns,\n",
    "        var_name=\"rent_range\",\n",
    "        value_name=\"dwelling_count\",\n",
    "    )\n",
    "    long_df = long_df[~long_df[\"rent_range\"].isin([\"Not stated\", \"Not applicable\", \"Total\"])]\n",
    "    long_df[\"dwelling_count\"] = pd.to_numeric(long_df[\"dwelling_count\"], errors=\"coerce\")\n",
    "    long_df = long_df.dropna(subset=[\"dwelling_count\"])\n",
    "\n",
    "    long_df[\"rent_midpoint\"] = long_df[\"rent_range\"].apply(rent_range_to_midpoint_au)\n",
    "    long_df[\"region\"] = long_df[\"remoteness_area\"].apply(classify_region_au)\n",
    "    long_df[\"country\"] = \"Australia\"\n",
    "\n",
    "    return long_df\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# NEW ZEALAND\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def rent_range_to_midpoint_nz(range_str):\n",
    "    \"\"\"Convert a Stats NZ rent range string into its numeric midpoint.\n",
    "    Handles the open-ended bottom ('Under $200') and top ('$800 and over') bands\n",
    "    with assumed midpoints -- stated assumptions, since these have no fixed bound.\"\"\"\n",
    "    if range_str == \"Under $200\":\n",
    "        return 150.0  # assumption: extends the ~$100 band width below $200\n",
    "    if range_str == \"$800 and over\":\n",
    "        return 900.0  # assumption: extends the ~$100 band width above $800\n",
    "    numbers = re.findall(r\"\\d+\", range_str)\n",
    "    low, high = int(numbers[0]), int(numbers[1])\n",
    "    return (low + high) / 2\n",
    "\n",
    "\n",
    "def classify_region_nz(area):\n",
    "    \"\"\"\n",
    "    Auckland Region is NZ's dominant major urban centre; all other regions\n",
    "    are classified as regional for this simple urban/regional split.\n",
    "    \"\"\"\n",
    "    return \"urban\" if area == \"Auckland Region\" else \"regional\"\n",
    "\n",
    "\n",
    "def load_and_clean_nz(filepath):\n",
    "    df = pd.read_csv(filepath)\n",
    "\n",
    "    df = df.rename(columns={\n",
    "        \"Area\": \"area\",\n",
    "        \"Weekly rent paid by household\": \"rent_range\",\n",
    "        \"Household composition\": \"household_type\",\n",
    "        \"OBS_VALUE\": \"dwelling_count\",  # the human-readable \"Observation Value\" column is blank in this export\n",
    "    })\n",
    "\n",
    "    keep_cols = [\"area\", \"rent_range\", \"household_type\", \"dwelling_count\"]\n",
    "    df = df[keep_cols]\n",
    "\n",
    "    # Remove aggregate/non-data categories\n",
    "    exclude_area = [\"Total - New Zealand by regional council\"]\n",
    "    exclude_rent = [\n",
    "        \"Total stated - weekly rent paid by household\",\n",
    "        \"Total - weekly rent paid by household\",\n",
    "        \"Not elsewhere included\",\n",
    "    ]\n",
    "    exclude_household = [\n",
    "        \"Total - household composition\",\n",
    "        \"Total stated - household composition\",\n",
    "        \"Household composition unidentifiable\",\n",
    "    ]\n",
    "\n",
    "    df = df[~df[\"area\"].isin(exclude_area)]\n",
    "    df = df[~df[\"rent_range\"].isin(exclude_rent)]\n",
    "    df = df[~df[\"household_type\"].isin(exclude_household)]\n",
    "\n",
    "    df[\"dwelling_count\"] = pd.to_numeric(df[\"dwelling_count\"], errors=\"coerce\")\n",
    "    df = df.dropna(subset=[\"dwelling_count\"])\n",
    "\n",
    "    df[\"rent_midpoint\"] = df[\"rent_range\"].apply(rent_range_to_midpoint_nz)\n",
    "    df[\"region\"] = df[\"area\"].apply(classify_region_nz)\n",
    "    df[\"country\"] = \"New Zealand\"\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# SHARED ANALYSIS\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def compute_median_rent_gap(long_df):\n",
    "    \"\"\"Expands grouped counts into individual observations, then computes\n",
    "    median rent per household_type x region, and the resulting urban-regional gap.\"\"\"\n",
    "    expanded = long_df.loc[long_df.index.repeat(long_df[\"dwelling_count\"].astype(int))]\n",
    "    result = (\n",
    "        expanded.groupby([\"household_type\", \"region\"])[\"rent_midpoint\"]\n",
    "        .median()\n",
    "        .unstack()\n",
    "        .reset_index()\n",
    "    )\n",
    "    result[\"rent_gap\"] = result[\"urban\"] - result[\"regional\"]\n",
    "    return result.sort_values(\"rent_gap\", ascending=False)\n",
    "\n",
    "\n",
    "def plot_rent_gap(au_result, nz_result):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 6), sharey=False)\n",
    "\n",
    "    for ax, result, title in zip(axes, [au_result, nz_result], [\"Australia (2021)\", \"New Zealand (2023)\"]):\n",
    "        x = range(len(result))\n",
    "        width = 0.35\n",
    "        ax.bar([i - width / 2 for i in x], result[\"regional\"], width, label=\"Regional\", color=\"#4C72B0\")\n",
    "        ax.bar([i + width / 2 for i in x], result[\"urban\"], width, label=\"Urban\", color=\"#DD8452\")\n",
    "        ax.set_xticks(list(x))\n",
    "        ax.set_xticklabels(result[\"household_type\"], rotation=45, ha=\"right\", fontsize=8)\n",
    "        ax.set_ylabel(\"Median weekly rent ($)\")\n",
    "        ax.set_title(title)\n",
    "        ax.legend()\n",
    "\n",
    "    fig.suptitle(\"Median Weekly Rent by Household Type: Urban vs Regional\", fontsize=14)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    au_long = load_and_clean_au(\"Datasets/AUS/2021Census_GCP_AUS.csv\")\n",
    "    nz_long = load_and_clean_nz(\"Datasets/NZ/NZ,CEN23_HOU_022.csv\")\n",
    "\n",
    "    au_result = compute_median_rent_gap(au_long)\n",
    "    nz_result = compute_median_rent_gap(nz_long)\n",
    "\n",
    "    print(\"=== Australia: median rent by household type and region ===\")\n",
    "    print(au_result.to_string(index=False))\n",
    "\n",
    "    print(\"\\n=== New Zealand: median rent by household type and region ===\")\n",
    "    print(nz_result.to_string(index=False))\n",
    "\n",
    "    print(\"\\n=== Comparison of rent gap ranges ===\")\n",
    "    print(f\"Australia gap range: ${au_result['rent_gap'].min():.0f} - ${au_result['rent_gap'].max():.0f}\")\n",
    "    print(f\"New Zealand gap range: ${nz_result['rent_gap'].min():.0f} - ${nz_result['rent_gap'].max():.0f}\")\n",
    "\n",
    "    plot_rent_gap(au_result, nz_result)"
   ]
  },
