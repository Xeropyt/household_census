    "def parse_rent_band(label):\n",
    "    \"\"\"Convert a rent-band label into numeric (lower, upper) weekly-rent edges.\n",
    "\n",
    "    Handles both countries' formats: '$1-$74', '$200 - $299', 'Under $200'\n",
    "    and '$950 and over'. Upper edges are exclusive, e.g. '$200 - $299' -> (200, 300);\n",
    "    open-ended top bands get an upper edge of infinity.\n",
    "    \"\"\"\n",
    "    text = label.replace(\"$\", \"\").replace(\",\", \"\").lower()   # e.g. \"200 - 299\"\n",
    "    if text.startswith(\"under\"):                              # \"under 200\"\n",
    "        return 0, int(text.split()[1])\n",
    "    if \"over\" in text:                                        # \"950 and over\"\n",
    "        return int(text.split()[0]), np.inf\n",
    "    low, high = text.split(\"-\")                               # \"1-74\" or \"200 - 299\"\n",
    "    return int(low), int(high) + 1\n",
    "\n",
    "\n",
    "def map_household_type(label, prefix_map):\n",
    "    \"\"\"Return the common household-type label, or NaN if the raw type is excluded.\"\"\"\n",
    "    for prefix, common in prefix_map.items():\n",
    "        if label.startswith(prefix):\n",
    "            return common\n",
    "    return np.nan\n",
    "\n",
    "\n",
    "def harmonise(df, prefix_map):\n",
    "    \"\"\"Add numeric band edges, map household types to the common set, drop\n",
    "    excluded types and sum counts within each area x household type x band.\"\"\"\n",
    "    edges = df[\"rent_band\"].map(parse_rent_band)\n",
    "    df = df.assign(band_low=edges.str[0], band_high=edges.str[1],\n",
    "                   household_type=df[\"raw_household\"].map(\n",
    "                       lambda s: map_household_type(s, prefix_map)))\n",
    "    df = df.dropna(subset=[\"household_type\"])\n",
    "    keys = [\"country\", \"area\", \"household_type\", \"rent_band\", \"band_low\", \"band_high\"]\n",
    "    return df.groupby(keys, as_index=False)[\"count\"].sum()"
   ]
