    "def clean_nz_data(file_path, prefix_map, excluded_areas, excluded_rent,\n",
    "                  income_total, national_label):\n",
    "    \"\"\"Load the Stats NZ Aotearoa Data Explorer export and return a tidy long-format table.\"\"\"\n",
    "    raw = pd.read_csv(file_path)\n",
    "    nz = raw[(raw[\"Total household income\"] == income_total)\n",
    "             & ~raw[\"Area\"].isin(excluded_areas)\n",
    "             & ~raw[\"Weekly rent paid by household\"].isin(excluded_rent)]\n",
    "    nz = nz.rename(columns={\"Area\": \"area\",\n",
    "                            \"Household composition\": \"raw_household\",\n",
    "                            \"Weekly rent paid by household\": \"rent_band\",\n",
    "                            \"OBS_VALUE\": \"count\"})\n",
    "    # Confidential cells (status \"c\") have no value; all of them should be in excluded areas\n",
    "    assert nz[\"OBS_STATUS\"].ne(\"c\").all(), \"Confidential cells remain after exclusions\"\n",
    "\n",
    "    nz = nz[[\"raw_household\", \"area\", \"rent_band\", \"count\"]].copy()\n",
    "    nz[\"area\"] = nz[\"area\"].replace({national_label: NATIONAL})\n",
    "    nz[\"country\"] = \"New Zealand\"\n",
    "    return harmonise(nz, prefix_map)\n",
    "\n",
    "\n",
    "nz_rent = clean_nz_data(NZ_FILE, HOUSEHOLD_PREFIX_MAP_NZ, NZ_EXCLUDED_AREAS,\n",
    "                        NZ_EXCLUDED_RENT, NZ_INCOME_TOTAL, NZ_NATIONAL_LABEL)\n",
    "display(nz_rent.head())"
   ]
  },
