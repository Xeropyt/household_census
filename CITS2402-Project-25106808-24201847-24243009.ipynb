   "source": [
    "**3.5 Estimating Median Rent from Banded Data**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "505b8fc2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def grouped_median(group, count_col=\"count\"):\n",
    "    \"\"\"Estimate the median weekly rent from banded counts by linear interpolation.\"\"\"\n",
    "    # Combine rows that share a band (e.g. several household types), then order bands\n",
    "    bands = (group.groupby([\"band_low\", \"band_high\"], as_index=False)[count_col]\n",
    "                  .sum().sort_values(\"band_low\"))\n",
    "    counts = bands[count_col].to_numpy(float)\n",
    "    cumulative = counts.cumsum()\n",
    "    half = cumulative[-1] / 2\n",
    "    k = np.searchsorted(cumulative, half)              # index of the median band\n",
    "    below = cumulative[k - 1] if k > 0 else 0.0\n",
    "    low, high = bands[\"band_low\"].iloc[k], bands[\"band_high\"].iloc[k]\n",
    "    if np.isinf(high):\n",
    "        return low          # median in the open top band: report its lower edge\n",
    "    return low + (half - below) / counts[k] * (high - low)\n",
    "\n",
    "\n",
    "def median_table(df, by):\n",
    "    \"\"\"Estimated median weekly rent and number of households for each group in `by`.\"\"\"\n",
    "    rows = [{**dict(zip(by, key if isinstance(key, tuple) else (key,))),\n",
    "             \"median_rent\": grouped_median(g), \"households\": g[\"count\"].sum()}\n",
    "            for key, g in df.groupby(by)]\n",
    "    return pd.DataFrame(rows)"
   ]
  },
